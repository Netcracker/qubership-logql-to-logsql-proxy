server:
  listenAddr: ":3100"
  writeTimeout: 60s
  # Increase if Grafana sends long query strings and the proxy returns 431
  # "Too big request header".
  readBufferSize: 65536

vlogs:
  url: "http://victorialogs:9428"
  timeout: 30s
  maxIdleConns: 100
  maxConnsPerHost: 50

  # Option A: HTTP Basic auth
  # basicAuth:
  #   username: "grafana-proxy"
  #   passwordFile: "/run/secrets/vlogs-password"

  # Option B: Bearer token
  # bearerToken: "my-secret-token"

  # Extra headers added to every VL request
  # extraHeaders:
  #   X-Tenant-ID: "production"

  # Extra query string params added to every VL request
  # extraParams:
  #   accountID: "42"

limits:
  maxConcurrentQueries: 50
  maxQueueDepth: 100
  maxResponseBodyBytes: 67108864  # 64 MiB
  maxStreamsPerResponse: 5000
  aggregationScanLimit: 0         # 0 = unlimited for aggregation queries
  maxMemoryMB: 512
  maxQueryRangeHours: 24
  maxLimit: 5000
  defaultLimit: 1000

labels:
  # Leave empty to discover dynamically from VL /field_names
  knownLabels: []

  # Optional metadata filters for label and field discovery endpoints.
  # Empty allow-lists mean "allow everything".
  # allowLabels:
  #   - app
  #   - namespace
  # denyLabels:
  #   - _stream
  # allowFields:
  #   - level
  #   - detected_level
  # denyFields:
  #   - _msg

  # Optional fallback fields used to synthesize Grafana's service_name label
  # when the logs do not store service_name directly.
  # serviceNameFallbackFields:
  #   - service_name
  #   - service.name
  #   - app
  #   - container

  # Optional label translation for legacy pipelines that do not store
  # Grafana-compatible labels directly.
  # labelRemap:
  #   detected_level: level

  metadataCacheTTL: 5m
  metadataCacheSize: 256

log:
  level: "info"
  format: "json"

drilldownLimits:
  # Returned to Grafana as discover_log_levels.
  discoverLogLevels: true
  # Ordered candidate fields Grafana may use to infer service names in Drilldown.
  discoverServiceName:
    - service
    - app
    - application
  # Field names Grafana should treat as level/severity fields.
  logLevelFields:
    - detected_level
    - level
    - severity
  # Defaults to limits.maxLimit when omitted.
  maxEntriesLimitPerQuery: 5000
  maxLineSizeTruncate: false
  maxQueryBytesRead: "0B"
  maxQueryLength: "30d1h"
  maxQueryLookback: "31d"
  maxQueryRange: "0s"
  # Defaults to limits.maxStreamsPerResponse when omitted.
  maxQuerySeries: 500
  metricAggregationEnabled: true
  # OTLP resource attributes advertised as indexed metadata for Drilldown.
  otlpResourceAttributes:
    - service.name
    - k8s.namespace.name
    - k8s.pod.name
  patternPersistenceEnabled: false
  # Defaults to vlogs.timeout when omitted.
  queryTimeout: "5m"
  # Retention period reported to Grafana.
  retentionPeriod: "31d"
  # Enables volume panels and sets the advertised series cap.
  volumeEnabled: true
  volumeMaxSeries: 100000000
  patternIngesterEnabled: true
  version: "fake"
